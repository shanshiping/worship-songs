# PostgreSQL（Prisma 7 + @prisma/adapter-pg；不要用 SQLite file: URL）
# 本地 Docker（docker compose up -d）：
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/worship_songs"
# 远程 / 托管库示例：
# DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"

# NextAuth（必须与实际访问端口一致；若 3000 被占用改成 3001 等）
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="replace-with-a-long-random-string"

# Gemini Vision（歌谱 OCR 提取歌词；未配置时识别接口返回 503）
GEMINI_API_KEY=

# 应用 URL（分享链接等；与 NEXTAUTH_URL 同端口）
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# 选歌 Agent（Vercel AI SDK；OpenAI 兼容。免费测试推荐 Groq）
# 申请 Key：https://console.groq.com/keys
AI_PROVIDER="openai"
AI_API_KEY=""
AI_BASE_URL="https://api.groq.com/openai/v1"
AI_MODEL="llama-3.3-70b-versatile"
# 限流时可改用：AI_MODEL="llama-3.1-8b-instant"
