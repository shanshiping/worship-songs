# PostgreSQL（Prisma 7 + @prisma/adapter-pg；不要用 SQLite file: URL）
# 本地 Docker（docker compose up -d）：
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/worship_songs"
# 远程 / 托管库示例：
# DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"

# NextAuth（必须与实际访问端口一致；若 3000 被占用改成 3001 等）
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="replace-with-a-long-random-string"

# Gemini Vision（歌谱 OCR 提取歌词；未配置时识别接口返回 503）
GEMINI_API_KEY=

# 应用 URL（分享链接等；与 NEXTAUTH_URL 同端口）
NEXT_PUBLIC_APP_URL="http://localhost:3000"
