# PostgreSQL（Prisma 7 + @prisma/adapter-pg；不要用 SQLite file: URL）
# 本地 Docker（docker compose up -d）：
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/worship_songs"
# 远程 / 托管库示例：
# DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"

# NextAuth（必须与实际访问端口一致；若 3000 被占用改成 3001 等）
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="replace-with-a-long-random-string"

# 歌谱 OCR（提取歌词）。provider: gemini | openai（OpenAI 兼容，如 OpenAI / 部分代理）
# 未显式设置 LYRICS_OCR_PROVIDER 时：有 GEMINI_API_KEY 用 gemini，否则有 AI_API_KEY 用 openai
LYRICS_OCR_PROVIDER=gemini

# Gemini（支持图片 + PDF）
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# OpenAI 兼容（仅图片；PDF 请用 Gemini）
# LYRICS_OCR_PROVIDER=openai
# LYRICS_OCR_API_KEY=
# LYRICS_OCR_BASE_URL=https://api.openai.com/v1
# LYRICS_OCR_MODEL=gpt-4o-mini
# 也可复用下方选歌 Agent 的 AI_API_KEY / AI_BASE_URL / AI_MODEL

# 应用 URL（分享链接等；与 NEXTAUTH_URL 同端口）
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# 选歌 Agent（Vercel AI SDK；OpenAI 兼容。免费测试推荐 Groq）
# 申请 Key：https://console.groq.com/keys
AI_PROVIDER="openai"
AI_API_KEY=""
AI_BASE_URL="https://api.groq.com/openai/v1"
AI_MODEL="llama-3.3-70b-versatile"
# 限流时可改用：AI_MODEL="llama-3.1-8b-instant"
