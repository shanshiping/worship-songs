// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// 用户表
model User {
  id        String   @id @default(cuid())
  name      String?
  email     String   @unique
  phone     String?  @unique
  password  String
  role      String   @default("MEMBER") // SUPER_ADMIN, ADMIN, LEADER, MEMBER
  avatar    String?
  emailVerified DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // 关联
  ownedTeams  Team[]       @relation("TeamOwner")
  teamMembers TeamMember[]
  messages    Message[]
  playlists   Playlist[]
  songsUploaded  Song[] @relation("SongUploader")
  sheetsUploaded Song[] @relation("SheetUploader")
  teamSongsShared TeamSong[] @relation("TeamSongSharer")
}

// 团队表
model Team {
  id          String   @id @default(cuid())
  name        String
  description String?
  avatar      String?
  ownerId     String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  owner   User         @relation("TeamOwner", fields: [ownerId], references: [id])
  members TeamMember[]
  messages Message[]
  songs   TeamSong[]
}

// 团队成员表
model TeamMember {
  id       String   @id @default(cuid())
  teamId   String
  userId   String
  role     String   @default("MEMBER") // OWNER, ADMIN, MEMBER
  joinedAt DateTime @default(now())

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([teamId, userId])
}

// 聊天消息表
model Message {
  id        String   @id @default(cuid())
  content   String
  type      String   @default("TEXT") // TEXT, IMAGE, FILE
  teamId    String
  userId    String
  createdAt DateTime @default(now())

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// 歌曲表
model Song {
  id            String   @id @default(cuid())
  title         String
  artist        String?
  key           String?  // 调，如 C、G、Am
  timeSignature String?  // 拍，如 4/4、6/8
  composer      String?  // 作曲
  lyricist      String?  // 作词
  team          String?  // 团队（自由文本）
  album         String?  // 专辑
  mvUrl         String?  // MV 外链
  coverImage    String?  // 封面图片路径
  pptBackground String?  // PPT 投影默认背景图路径
  sheetMusic    String?  // 歌谱文件路径
  audioFile     String?  // 音频文件路径
  lyrics        String?  // 纯文本歌词
  lyricsLrc     String?  // 可选 LRC 时间轴歌词
  notes         String?  // 备注
  uploadedById  String?  // 歌曲上传者
  sheetUploadedById String? // 歌谱上传者
  sheetUploadedAt   DateTime? // 歌谱上传时间
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  uploadedBy      User?          @relation("SongUploader", fields: [uploadedById], references: [id], onDelete: SetNull)
  sheetUploadedBy User?          @relation("SheetUploader", fields: [sheetUploadedById], references: [id], onDelete: SetNull)
  tags       SongTag[]
  meetings   MeetingSong[]
  playlists  PlaylistSong[]
  scriptures SongScripture[]
  teamShares TeamSong[]
}

model SongScripture {
  id        String  @id @default(cuid())
  songId    String
  reference String
  text      String?
  order     Int

  song Song @relation(fields: [songId], references: [id], onDelete: Cascade)

  @@unique([songId, order])
}

// 标签（类型 / 风格）
model Tag {
  id   String @id @default(cuid())
  name String
  kind String // TYPE | STYLE

  songs SongTag[]

  @@unique([name, kind])
}

model SongTag {
  id     String @id @default(cuid())
  songId String
  tagId  String

  song Song @relation(fields: [songId], references: [id], onDelete: Cascade)
  tag  Tag  @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@unique([songId, tagId])
}

// 歌单
model Playlist {
  id          String   @id @default(cuid())
  title       String
  description String?
  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  createdBy User           @relation(fields: [createdById], references: [id])
  songs     PlaylistSong[]
}

model PlaylistSong {
  id         String @id @default(cuid())
  playlistId String
  songId     String
  order      Int

  playlist Playlist @relation(fields: [playlistId], references: [id], onDelete: Cascade)
  song     Song     @relation(fields: [songId], references: [id], onDelete: Cascade)

  @@unique([playlistId, songId])
}

// 聚会记录表
model Meeting {
  id          String   @id @default(cuid())
  date        DateTime
  theme       String?  // 主题信息
  speaker     String?  // 讲员
  leader      String?  // 主领
  type        String   @default("MORNING") // MORNING, AFTERNOON, EVENING
  notes       String?  // 备注
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  songs MeetingSong[]
}

// 聚会歌曲关联表
model MeetingSong {
  id        String  @id @default(cuid())
  meetingId String
  songId    String
  order     Int     // 歌曲顺序

  meeting Meeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  song    Song    @relation(fields: [songId], references: [id], onDelete: Cascade)

  @@unique([meetingId, songId])
}

// 团队共享歌曲
model TeamSong {
  id         String   @id @default(cuid())
  teamId     String
  songId     String
  sharedById String
  sharedAt   DateTime @default(now())

  team     Team @relation(fields: [teamId], references: [id], onDelete: Cascade)
  song     Song @relation(fields: [songId], references: [id], onDelete: Cascade)
  sharedBy User @relation("TeamSongSharer", fields: [sharedById], references: [id])

  @@unique([teamId, songId])
}
