# Production env template for Docker / Tencent Cloud deployment.
# Copy: cp .env.production.example .env

# --- Database ---
# TencentDB for PostgreSQL example:
# DATABASE_URL="postgresql://USER:PASSWORD@10.x.x.x:5432/worship_songs?sslmode=require"
# Single-server docker compose with profile local-db:
DATABASE_URL="postgresql://postgres:postgres@postgres:5432/worship_songs"

# --- NextAuth (must match public URL) ---
NEXTAUTH_URL="https://your-domain.com"
NEXTAUTH_SECRET="replace-with-openssl-rand-base64-32"

# --- App URL (share links) ---
NEXT_PUBLIC_APP_URL="https://your-domain.com"

# --- Docker only ---
APP_PORT=3000
RUN_DB_PUSH=true

# --- Optional: local Postgres profile (docker compose --profile local-db) ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_DB=worship_songs
POSTGRES_PORT=5432

# --- Email verification (recommended in production) ---
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=noreply@example.com
# SMTP_PASS=
# SMTP_FROM=noreply@example.com

# --- Lyrics OCR (optional) ---
# LYRICS_OCR_PROVIDER=gemini
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.0-flash

# --- Song selection Agent (optional) ---
# AI_PROVIDER=openai
# AI_API_KEY=
# AI_BASE_URL=https://api.groq.com/openai/v1
# AI_MODEL=llama-3.3-70b-versatile
